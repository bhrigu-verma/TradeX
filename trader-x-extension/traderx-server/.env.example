# TraderX Server Environment Variables
# Copy this file to .env and fill values for your environment.

# =============================================
# SERVER
# =============================================
PORT=3001
NODE_ENV=development

# =============================================
# TELEGRAM
# =============================================
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Public base URL where Telegram can reach your server
# Example: https://api.yourdomain.com
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=         # random secret sent in X-Telegram-Bot-Api-Secret-Token header

# =============================================
# TWITTER / X API
# =============================================
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# =============================================
# PRICE DATA
# =============================================
COINGECKO_API_KEY=demo
YAHOO_FINANCE_PROXY=https://query1.finance.yahoo.com

# =============================================
# AUTH / SECURITY
# =============================================
JWT_SECRET=change_this_to_a_long_random_value
API_KEY_SALT=change_this_to_another_random_value

# =============================================
# DATABASE
# =============================================
DB_PATH=./data/traderx.db

# =============================================
# REDIS
# =============================================
REDIS_URL=redis://localhost:6379
USE_REDIS=false

# =============================================
# OPENAI
# =============================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# =============================================
# DISCORD
# =============================================
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ALERT_CHANNEL_ID=

# =============================================
# STRIPE
# =============================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=

# =============================================
# APP
# =============================================
FRONTEND_URL=http://localhost:3000
