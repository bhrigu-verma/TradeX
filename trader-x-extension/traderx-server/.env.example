# TraderX Server Environment Variables
# Copy this to .env and fill in your values

# =============================================
# SERVER CONFIG
# =============================================
PORT=3001
NODE_ENV=development

# =============================================
# TELEGRAM BOT
# =============================================
# Get from @BotFather on Telegram → /newbot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/webhook/telegram

# =============================================
# TWITTER / X API
# =============================================
# Get from developer.twitter.com → Basic plan ($100/mo)
# For testing without it, the server works in DEMO mode
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TWITTER_API_KEY=your_api_key
TWITTER_API_SECRET=your_api_secret

# =============================================
# PRICE APIS (Free)
# =============================================
COINGECKO_API_KEY=demo  # or get free key at coingecko.com
YAHOO_FINANCE_PROXY=https://query1.finance.yahoo.com

# =============================================
# AUTH & SECURITY
# =============================================
JWT_SECRET=change_this_to_a_long_random_string_in_production
API_KEY_SALT=another_random_string

# =============================================
# DATABASE (SQLite — no setup needed!)
# =============================================
DB_PATH=./data/traderx.db

# =============================================
# REDIS (Optional — for job queues)
# =============================================
REDIS_URL=redis://localhost:6379
USE_REDIS=false  # Set to true if Redis is running

# =============================================
# OPENAI (Optional — for AI digests)
# =============================================
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# =============================================
# DISCORD BOT (Optional)
# =============================================
DISCORD_BOT_TOKEN=your_discord_bot_token_here
